    "cors": "^2.8.6",
    "dotenv": "16.6.1",
    "express": "^5.2.1",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "prisma": "6.19.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
