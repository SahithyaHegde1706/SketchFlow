{
  "name": "sketchflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @sketchflow/frontend dev",
    "dev:backend": "pnpm --filter @sketchflow/backend dev",
    "dev:all": "pnpm --filter @sketchflow/frontend dev & pnpm --filter @sketchflow/backend dev",
    "build": "pnpm --filter @sketchflow/frontend build",
    "start": "pnpm --filter @sketchflow/frontend start",
    "lint": "pnpm --filter @sketchflow/frontend lint",
    "lint:backend": "pnpm --filter @sketchflow/backend typecheck",
    "typecheck": "pnpm --filter @sketchflow/frontend typecheck"
  },
  "packageManager": "pnpm@11.3.0"
}
